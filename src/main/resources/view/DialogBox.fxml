<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17.0.7"
         xmlns:fx="http://javafx.com/fxml/1" spacing="8.0">
    <children>
        <Label fx:id="messageLabel" wrapText="true" maxWidth="560.0"
               style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10;">
            <padding>
                <Insets top="10.0" right="12.0" bottom="10.0" left="12.0" />
            </padding>
        </Label>
    </children>
</fx:root>
