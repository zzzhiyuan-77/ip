<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="moon.MainWindow" prefWidth="700.0" prefHeight="520.0"
            style="-fx-background-color: #f4f7fb;">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" fillWidth="true">
                    <padding>
                        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10.0" style="-fx-background-color: white;">
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
            </padding>
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS" promptText="Enter a command"
                       onAction="#handleUserInput" />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                    text="Send" />
        </HBox>
    </bottom>
</BorderPane>
